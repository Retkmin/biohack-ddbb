{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biohack.local/schemas/control-manifest.schema.json",
  "title": "Greenfield Deployment Plan (VPS)",
  "description": "Immutable configuration authority for the first greenfield VPS deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_sha256", "environment", "backend_digest", "frontend_digest", "dns_names", "approvals", "protected_config_attestation", "tls_readiness", "capacity_limits", "retention_window", "state", "receipt_ids", "residual_risk_recorded"],
  "properties": {
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment": {"type": "string", "enum": ["vps-greenfield"]},
    "backend_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frontend_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dns_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight", "initialization", "activation"],
      "properties": {
        "preflight": {"$ref": "#/$defs/approval"},
        "initialization": {"$ref": "#/$defs/approval"},
        "activation": {"$ref": "#/$defs/approval"}
      }
    },
    "protected_config_attestation": {"type": "string", "minLength": 1},
    "tls_readiness": {"type": "object", "additionalProperties": false, "required": ["attested"], "properties": {"attested": {"type": "boolean"}}},
    "capacity_limits": {"type": "object", "additionalProperties": false, "required": ["attested"], "properties": {"attested": {"type": "boolean"}}},
    "retention_window": {"type": "integer", "minimum": 1},
    "state": {"type": "string", "enum": ["preflight", "initialized", "healthy", "active", "blocked"]},
    "receipt_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "residual_risk_recorded": {"type": "boolean"}
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "approver", "approval_id", "issued_at", "expires_at"],
      "properties": {
        "approved": {"type": "boolean"},
        "approver": {"type": "string", "minLength": 1},
        "approval_id": {"type": "string", "minLength": 1},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
