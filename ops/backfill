#!/bin/sh
# ops/backfill — credential-free, idempotent, checksummed profile backfill.
#
# Delegates the backfill contract (app.infrastructure.migration.backfill) to the
# backend adapter via Compose. --dry-run (default) emits a plan and performs no
# write; --apply runs the idempotent, checksummed backfill. No backend SQL is
# copied here and no database credentials are accepted or emitted.
set -u
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/lib/operation-contract.sh"
contract_main "backfill" "$@"
exit $?
